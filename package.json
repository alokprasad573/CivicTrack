{
  "name": "civictrack",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "CivicTrack — Smart Civic Complaint Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@civictrack/server",
    "dev:web": "npm run dev --workspace=@civictrack/web",
    "dev": "npm run dev --workspace=@civictrack/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "civic-tech",
    "complaint-management",
    "nextjs",
    "express",
    "mongodb"
  ],
  "author": "CivicTrack Team",
  "license": "ISC",
  "allowScripts": {
    "@clerk/shared@3.48.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
